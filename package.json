{
  "name": "orc",
  "version": "0.1.0",
  "description": "A tiny TUI launcher for resuming Claude Code sessions, with live status.",
  "type": "module",
  "bin": {
    "orc": "./bin/orc.mjs"
  },
  "scripts": {
    "start": "tsx src/index.tsx",
    "dev": "tsx watch src/index.tsx",
    "stagetest": "ORC_SOCKET=orc-test tsx src/stage-test.ts",
    "scannertest": "tsx src/scanner-test.ts"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
